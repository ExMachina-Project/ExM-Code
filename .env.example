# Copy values into your shell environment; .env is not loaded automatically.
EXM_CODE_BASE_URL=https://api.openai.com/v1
EXM_CODE_MODEL=gpt-4.1
EXM_CODE_API_KEY=
# Optional separate private state directory. Defaults to <workspace>/.exm-code.
# EXM_CODE_DATA_DIR=/path/to/private/state
# Remote API server only: required for non-loopback binds.
# EXM_CODE_AUTH_TOKEN=generate-a-random-token-at-least-32-characters
# Web client build/runtime connection:
# VITE_EXM_CODE_SERVER_URL=https://agent.example.com
